{
  "name": "alexandre-martins-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:install": "playwright install chromium",
    "audit:performance": "node scripts/lighthouse.mjs",
    "format": "prettier --write index.html src tests scripts vite.config.ts playwright.config.ts tsconfig.json package.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource/dm-mono": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.0.0",
    "lighthouse": "^13.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  }
}
